# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for dev/demo — no setup required)
DATABASE_URL=sqlite+aiosqlite:///./rapidaid.db
SYNC_DATABASE_URL=sqlite:///./rapidaid.db

# PostgreSQL (uncomment for production):
# DATABASE_URL=postgresql+asyncpg://rapidaid:rapidaid123@localhost:5432/rapidaid_db
# SYNC_DATABASE_URL=postgresql://rapidaid:rapidaid123@localhost:5432/rapidaid_db

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production-32chars!!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── External APIs ─────────────────────────────────────────────────────────────
# Groq API Key (using LLaMA 3.3) — leave empty to use rule-based triage
GROQ_API_KEY="your_groq_api_key_here"

# OpenRouteService — for future turn-by-turn routing
ORS_API_KEY=demo

# ── App Behaviour ─────────────────────────────────────────────────────────────
DEBUG=True
DEMO_MODE=True
APP_NAME=RapidAid.ai
